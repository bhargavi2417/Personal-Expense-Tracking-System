# Copy this file to ".env" and enter YOUR OWN local MySQL details.
# Never share the real .env file or upload it to GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=expense_tracker

# Optional: any long random text. If omitted, a random one is generated at start-up.
SECRET_KEY=change-me-to-any-long-random-text

# Optional: currency symbol shown in the app
CURRENCY_SYMBOL=₹
